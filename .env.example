# === Mode ===
# When true, all external integrations return realistic simulated data instead
# of calling real APIs. Lets the whole system run and be demoed with zero
# credentials. Flip to false once real API keys are filled in below.
MOCK_MODE=true

# === NVIDIA NIM (semantic intent extraction — OpenAI-compatible API) ===
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b

# === Gmail & Google Calendar (OAuth 2.0 desktop app credentials) ===
GOOGLE_CREDENTIALS_PATH=./credentials/google_credentials.json
GOOGLE_TOKEN_PATH=./credentials/google_token.json
CALENDAR_IDS=primary
# Real-time Gmail push via Cloud Pub/Sub — see scripts/gmail_watch_setup.py.
# Leave both blank to fall back to manual/polling triggers only.
GMAIL_WATCH_TOPIC=
GMAIL_WEBHOOK_SECRET=

# === Slack ===
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APPROVALS_CHANNEL=#agent-approvals
SLACK_ACTIVITY_CHANNEL=#agent-activity
SLACK_CONFLICTS_CHANNEL=#agent-conflicts

# === Todoist ===
TODOIST_API_KEY=

# === Notion (knowledge graph) ===
NOTION_API_KEY=
NOTION_DECISIONS_DB_ID=

# === GitHub (bonus DevOps agent) ===
GITHUB_TOKEN=
GITHUB_REPO=

# === Google Sheets (bonus logging agent) ===
GOOGLE_SHEETS_SPREADSHEET_ID=

# === Telegram (bonus alert agent) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Discord (bonus social agent) ===
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_WEBHOOK_URL=

# === Backend ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# How long a workflow waits for a human approve/reject click before
# auto-rejecting. Keep short for quick demos; raise for real operation.
APPROVAL_TIMEOUT_SECONDS=300
DATABASE_URL=sqlite+aiosqlite:///./workflowos.db
# Example for Postgres: postgresql+asyncpg://user:password@localhost:5432/workflowos
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO

# === Frontend ===
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# === Deployment (used only by the Railway/Vercel CLIs when deploying —
# not read by the application itself, safe to leave blank until then) ===
RAILWAY_TOKEN=
VERCEL_TOKEN=
